rules_version = '2';
// Security rules per Ludi Sonores Firestore.
// LETTURA: pubblica (sito vetrina). SCRITTURA: solo admin whitelist.
//
// Per modificare la lista admin, aggiorna l'array `adminEmails` qui sotto
// e poi pubblica le nuove rules dalla Firebase Console.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
            'claudioaiello.developer@gmail.com',
            'ludisonores@gmail.com'
          ];
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bandi/{bandoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
